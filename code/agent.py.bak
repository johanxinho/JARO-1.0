def resolve_pc_path(filepath_str):
    clean_str = filepath_str.strip().strip("'\"")
    p = Path(clean_str).expanduser()
    if not p.is_absolute():
        proj_candidate = TOOLS["get_project"]() / p
        if proj_candidate.exists():
            return proj_candidate
        return Path.cwd() / p
    return p


def read_any_pc_file(filepath_str):
    p = resolve_pc_path(filepath_str)

    if not p.exists():
        return None, f"El archivo no existe: {p}"
    if p.is_dir():
        items = [x.name for x in sorted(p.iterdir())[:50]]
        return None, f"'{p}' es una carpeta. Contenido: {', '.join(items)}"

    suffix = p.suffix.lower()

    if suffix == ".pdf":
        try:
            from pypdf import PdfReader
            reader = PdfReader(str(p))
            paginas = []
            for idx, page in enumerate(reader.pages[:30], 1):
                txt = page.extract_text() or ""
                if txt.strip():
                    paginas.append(f"--- Pagina {idx} ---\n{txt.strip()}")
            contenido = "\n\n".join(paginas)
            return p, (contenido if contenido else "El PDF no contiene texto seleccionable.")
        except Exception as e:
            return None, f"Error leyendo PDF '{p}': {e}"

    if suffix == ".docx":
        try:
            import docx
            doc = docx.Document(str(p))
            parrafos = [para.text for para in doc.paragraphs if para.text.strip()]
            for table in doc.tables:
                for row in table.rows:
                    row_txt = " | ".join(cell.text.strip() for cell in row.cells if cell.text.strip())
                    if row_txt:
                        parrafos.append(row_txt)
            contenido = "\n".join(parrafos)
            return p, (contenido if contenido else "El documento Word esta vacio.")
        except Exception as e:
            return None, f"Error leyendo Word '{p}': {e}"

    try:
        if p.stat().st_size > 800_000:
            return None, f"Archivo demasiado grande (>800KB): {p}"
        return p, p.read_text(encoding="utf-8", errors="replace")
    except Exception as e:
        return None, f"No se pudo leer '{p}': {e}"


def analyze_image(filepath_str, custom_question=""):
    p = resolve_pc_path(filepath_str)
    if not p.exists() or not p.is_file():
        print(f"[ERROR] No se encontro la imagen: {p}")
        return

    print(f"\n{YELLOW}[JARO VISION]{RESET} Procesando imagen: {p}...")

    ocr_text = ""
    img_info = ""
    try:
        from PIL import Image
        import pytesseract
        with Image.open(p) as img:
            img_info = f"Formato: {img.format}, Resolucion: {img.size[0]}x{img.size[1]}, Modo: {img.mode}"
            ocr_raw = pytesseract.image_to_string(img, lang="spa+eng").strip()
            if ocr_raw:
                ocr_text = ocr_raw
    except Exception:
        pass

    if img_info:
        print(f"{CYAN}Propiedades:{RESET} {img_info}")
    if ocr_text:
        print(f"{CYAN}Texto detectado en la imagen (OCR):{RESET}\n{ocr_text[:600]}\n")

    vision_desc = ""
    try:
        requests.post(API, json={"model": MODEL, "keep_alive": 0}, timeout=10)
        img_b64 = base64.b64encode(p.read_bytes()).decode("utf-8")
        print(f"{CYAN}[Motor Vision: {VISION_MODEL}]{RESET} Observando detalles visuales...")
        resp = requests.post(
            API,
            json={
                "model": VISION_MODEL,
                "prompt": "Describe this image in detail, including objects, colors, text, interface elements, or people.",
                "images": [img_b64],
                "stream": False,
                "keep_alive": 0,
                "options": {"temperature": 0.2, "num_ctx": 1024}
            },
            timeout=180
        )
        if resp.status_code == 200:
            vision_desc = resp.json().get("response", "").strip()
    except Exception as e:
        print(f"[AVISO VISION] No se pudo invocar '{VISION_MODEL}' ({e}). Usando datos OCR.")

    pregunta = custom_question if custom_question else "Explica detalladamente que se muestra en la imagen y su contenido."
    prompt_final = f"""Datos extraidos de la imagen '{p.name}':
- Propiedades tecnicas: {img_info}
- Descripcion visual detectada: {vision_desc if vision_desc else 'No disponible'}
- Texto leido dentro de la imagen (OCR): {ocr_text if ocr_text else 'Ninguno'}

Con base en estos datos, responde en espanol de forma directa y completa a: {pregunta}"""

    print(f"{CYAN}[{MODEL}]{RESET} Generando analisis final...")
    ans = call_ollama(prompt_final, max_tokens=700)
    print(f"\n--- Analisis Visual JARO ({p.name}) ---\n{ans}\n------------------------------------------")
    save_memory(f"imagen: {p.name}", "analizar_imagen", [str(p)])


def search_internet(query, max_results=5):
    resultados = []
    try:
        from ddgs import DDGS
        with DDGS() as ddgs:
            for r in ddgs.text(query, max_results=max_results):
                titulo = r.get("title", "")
                cuerpo = r.get("body", "")
                href = r.get("href", "")
                if titulo or cuerpo:
                    resultados.append(f"- {titulo}: {cuerpo} ({href})")
    except Exception:
        pass

    if not resultados:
        try:
            wiki_url = (
                "https://es.wikipedia.org/w/api.php?action=query&list=search&srsearch="
                + urllib.parse.quote(query)
                + "&utf8=&format=json"
            )
            headers = {"User-Agent": "JaroAI/4.5 (Linux; Local Agent)"}
            r = requests.get(wiki_url, headers=headers, timeout=8)
            items = r.json().get("query", {}).get("search", [])
            for item in items[:max_results]:
                title = item.get("title", "")
                snippet = re.sub(r"<[^>]+>", "", item.get("snippet", "")).strip()
                resultados.append(f"- [Wikipedia] {title}: {snippet}")
        except Exception:
            pass

    if not resultados:
        try:
            from bs4 import BeautifulSoup
            headers = {"User-Agent": "Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:125.0) Gecko/20100101 Firefox/125.0"}
            resp = requests.post("https://lite.duckduckgo.com/lite/", data={"q": query}, headers=headers, timeout=10)
            soup = BeautifulSoup(resp.text, "html.parser")
            for td in soup.find_all("td", class_="result-snippet")[:max_results]:
                txt = td.get_text(" ", strip=True)
                if txt:
                    resultados.append(f"- {txt}")
        except Exception as e:
            return f"Error conectando a internet: {e}"

    return "\n".join(resultados) if resultados else "No se encontraron resultados en la web."


def get_history_file():
    return TOOLS["get_project"]() / ".jaro_history.json"


def save_memory(task, action_type, files_touched):
    hfile = get_history_file()
    history = []
    if hfile.is_file():
        try:
            history = json.loads(hfile.read_text(encoding="utf-8"))
        except Exception:
            history = []

    history.append({
        "fecha": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "proyecto": TOOLS["get_project"]().name,
        "tarea": task,
        "tipo": action_type,
        "archivos": files_touched
    })
    hfile.write_text(
        json.dumps(history[-25:], indent=2, ensure_ascii=False),
        encoding="utf-8"
    )


def show_memory():
    hfile = get_history_file()
    if not hfile.is_file():
        print("Aun no hay historial registrado en este proyecto.")
        return
    try:
        history = json.loads(hfile.read_text(encoding="utf-8"))
        print(f"\n=== MEMORIA DE JARO ({TOOLS['get_project']().name}) ===")
        for idx, item in enumerate(history[-10:], 1):
            archivos = ", ".join(item.get("archivos", []))
            print(f"{idx}. [{item['fecha']}] ({item['tipo']}) {item['tarea']} -> [{archivos}]")
    except Exception as e:
        print(f"Error leyendo memoria: {e}")


def clean_code(raw_text, filename=""):
    text = raw_text.strip()
    match = re.search(r"```(?:\w+)?\n(.*?)```", text, re.DOTALL)
    if match:
        text = match.group(1).strip()
    elif text.startswith("```"):
        lines = text.splitlines()[1:]
        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]
        text = "\n".join(lines).strip()

    if filename.endswith(".css"):
        text = re.sub(r"(?m)^-\s*\{", "* {", text)
    if filename.endswith(".html"):
        text = re.sub(r'\s+onclick=["\'][^"\']*["\']', '', text, flags=re.IGNORECASE)
    if filename.endswith((".css", ".js")):
        open_b = text.count("{")
        close_b = text.count("}")
        if open_b > close_b and (open_b - close_b) <= 2:
            text = text + ("\n}" * (open_b - close_b))
    return text


def ensure_interactive_html(html_code, task):
    injected = []
    if 'id="btn-accion"' not in html_code and "id='btn-accion'" not in html_code:
        injected.append('        <button id="btn-accion" class="btn">Explorar Ahora</button>')
    if 'id="mensaje-estado"' not in html_code and "id='mensaje-estado'" not in html_code:
        injected.append('        <p id="mensaje-estado" class="estado"></p>')

    if injected:
        block = "\n    <section class=\"card interactivo\">\n" + "\n".join(injected) + "\n    </section>\n"
        if "</main>" in html_code:
            html_code = html_code.replace("</main>", block + "</main>", 1)
        elif "</body>" in html_code:
            html_code = html_code.replace("</body>", block + "</body>", 1)
        else:
            html_code += block
    return html_code


def extract_html_selectors(html_code):
    ids = sorted(set(re.findall(r'id=["\']([^"\']+)["\']', html_code)))
    classes = sorted(set(re.findall(r'class=["\']([^"\']+)["\']', html_code)))
    return ids, classes


def smart_merge_python(old_code, new_code):
    try:
        old_tree = ast.parse(old_code)
        new_tree = ast.parse(new_code)
    except SyntaxError:
        return new_code

    old_funcs = {
        node.name: ast.get_source_segment(old_code, node)
        for node in old_tree.body if isinstance(node, ast.FunctionDef)
    }
    new_funcs = {
        node.name: ast.get_source_segment(new_code, node)
        for node in new_tree.body if isinstance(node, ast.FunctionDef)
    }

    missing_funcs = [name for name in old_funcs if name not in new_funcs]
    if not missing_funcs:
        return new_code

    merged_parts = []
    imports = [
        ast.get_source_segment(old_code, node)
        for node in old_tree.body if isinstance(node, (ast.Import, ast.ImportFrom))
    ]
    if imports:
        merged_parts.append("\n".join(imports))

    all_func_names = list(old_funcs.keys()) + [k for k in new_funcs if k not in old_funcs]
    for fname in all_func_names:
        if fname == "main":
            continue
        src = new_funcs.get(fname) or old_funcs.get(fname)
        if src:
            merged_parts.append(src)

    if "main" in new_funcs or "main" in old_funcs:
        merged_parts.append(new_funcs.get("main") or old_funcs.get("main"))

    if 'if __name__' in old_code and 'if __name__' not in "\n".join(merged_parts):
        merged_parts.append('if __name__ == "__main__":\n    main()')

    return "\n\n\n".join(merged_parts) + "\n"


def call_ollama(prompt, max_tokens=1100):
    response = requests.post(
        API,
        json={
            "model": MODEL,
            "prompt": prompt,
            "stream": False,
            "options": {
                "temperature": 0.7,
                "num_ctx": 2048,
                "num_predict": max_tokens,
                "repeat_penalty": 1.1
            }
        },
        timeout=300
    )
    response.raise_for_status()
    return response.json().get("response", "").strip()


def generate_code(task, filename, description, extra_context=""):
    prompt = f"""Genera el codigo fuente completo y funcional para el archivo: {filename}
Proyecto o requerimiento: {task}
Instruccion especifica: {description}
{extra_context}

REGLAS ABSOLUTAS:
1. Devuelve UNICAMENTE el codigo fuente de {filename}, sin texto introductorio ni conclusiones.
2. NO uses bloques Markdown (nada de ```).
3. PROHIBIDO usar 'Lorem ipsum'. Usa datos, nombres y textos reales y profesionales en espanol.
4. Codigo completo, optimizado y sin omitir partes clave.
"""
    raw = call_ollama(prompt)
    code = clean_code(raw, filename)
    if not code:
        raise ValueError(f"El modelo devolvio contenido vacio para {filename}")
    return code


def analyze_file(filename):
    p = resolve_pc_path(filename)
    if p.suffix.lower() in IMAGE_EXTS:
        analyze_image(filename)
        return

    path_obj, content = read_any_pc_file(filename)
    if path_obj is None:
        print(f"[ERROR] {content}")
        return

    print(f"\n[JARO ANALIZADOR] Analizando {path_obj}...")
    prompt = f"""Analiza el siguiente documento o archivo ({path_obj.name}) y explica su contenido clave, estructura o posibles mejoras de forma directa:
{content[:2500]}
"""
    res = call_ollama(prompt, max_tokens=600)
    print(f"\n--- Diagnostico JARO para {path_obj.name} ---\n{res}\n------------------------------------------")
    save_memory(f"analizar: {path_obj.name}", "analizar_archivo", [str(path_obj)])


def investigate_web(query):
    print(f"\n{YELLOW}[JARO WEB]{RESET} Investigando en internet: '{query}'...")
    web_data = search_internet(query)
    print(f"{CYAN}Resultados encontrados:{RESET}\n{web_data}\n")

    prompt = f"""Informacion extraida de internet sobre '{query}':
{web_data}

Con base en los datos anteriores y tu conocimiento tecnico, responde en espanol de forma clara, completa y directa a: {query}"""
    print(f"{CYAN}[{MODEL}]{RESET} Sintetizando respuesta...")
    ans = call_ollama(prompt, max_tokens=800)
    print(f"\n{ans}\n")
    save_memory(query, "investigar_web", ["internet"])


def open_in_browser():
    index_path = TOOLS["get_project"]() / "index.html"
    if not index_path.is_file():
        print(f"[ERROR] No se encontro index.html en {TOOLS['get_project']()}")
        return
    print(f"[JARO PREVIEW] Abriendo {index_path} en el navegador...")
    subprocess.Popen(["xdg-open", str(index_path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def create_website(task):
    print(f"\n[JARO PLANIFICADOR] Proyecto destino: {TOOLS['get_project']()}")
    print("[JARO PLANIFICADOR] Secuencia: 1) index.html -> 2) style.css -> 3) script.js -> 4) Verificacion DOM")

    print("\n(1/3) Generando index.html...")
    html_desc = (
        "Estructura HTML5 completa y profesional en espanol. "
        "Incluye <header>, <main class='container'>, secciones class='card', "
        "un boton <button id='btn-accion' class='btn'> y un <p id='mensaje-estado'></p>, y <footer>. "
        "Enlaza <link rel='stylesheet' href='style.css'> y <script src='script.js'></script>."
    )
    html_code = generate_code(task, "index.html", html_desc)
    html_code = ensure_interactive_html(html_code, task)
    print("[OK]", TOOLS["write_file"]("index.html", html_code))

    ids, classes = extract_html_selectors(html_code)
    context_html = f"Codigo real de index.html:\n{html_code}\n\nIDs: {ids}\nClases: {classes}\n"

    print("\n(2/3) Generando style.css sincronizado...")
    css_desc = (
        "Estilos CSS modernos, tema oscuro futurista (#0f172a), tarjetas (#1e293b), "
        "texto claro (#f8fafc) y boton interactivo (#00e5ff). "
        f"Estiliza las clases {classes} y IDs #{ids}. "
        "Inicia con * { box-sizing: border-box; margin: 0; padding: 0; } y cierra todas las llaves."
    )
    css_code = generate_code(task, "style.css", css_desc, context_html)
    print("[OK]", TOOLS["write_file"]("style.css", css_code))

    print("\n(3/3) Generando script.js sincronizado...")
    js_desc = (
        "JavaScript modular con document.addEventListener('DOMContentLoaded', ...). "
        "Conecta 'btn-accion' con 'mensaje-estado' para mostrar retroactividad visual interactiva."
    )
    js_code = generate_code(task, "script.js", js_desc, context_html)
    print("[OK]", TOOLS["write_file"]("script.js", js_code))

    print("\n[JARO VERIFICADOR] Comprobando DOM y llaves...")
    web_check = TOOLS["run_check"]("web")
    print(web_check)

    if "Codigo de salida: 0" not in web_check:
        print("[JARO AUTO-REPARACION] Sincronizando script.js...")
        safe_js = (
            "document.addEventListener('DOMContentLoaded', function() {\n"
            "    const btn = document.getElementById('btn-accion');\n"
            "    const estado = document.getElementById('mensaje-estado');\n"
            "    if (btn && estado) {\n"
            "        btn.addEventListener('click', function() {\n"
            "            estado.textContent = 'JARO AI CODE: Sistema operando al 100%.';\n"
            "            estado.style.color = '#00e5ff';\n"
            "        });\n"
            "    }\n"
            "});\n"
        )
        TOOLS["write_file"]("script.js", safe_js)

    print(f"[JARO VERIFICADOR] Selectores OK -> IDs: {ids} | Clases: {classes}")
    save_memory(task, "crear_web", ["index.html", "style.css", "script.js"])


def create_python_script(task):
    filename = "main.py"
    match = re.search(r"([\w\-]+\.py)", task)
    if match:
        filename = match.group(1)

    print(f"\n[JARO PLANIFICADOR] Creando script Python: {filename}")
    desc = "Script Python 3 robusto, limpio, con funciones modulares y bloque if __name__ == '__main__':"
    code = generate_code(task, filename, desc)
    print("[OK]", TOOLS["write_file"](filename, code))

    print(f"\n[JARO VERIFICADOR] Compilando {filename}...")
    check_res = TOOLS["run_check"]("compile", filename)
    print(check_res)

    if "Codigo de salida: 0" not in check_res:
        print("[JARO AUTO-REPARACION] Corrigiendo sintaxis Python...")
        fix_ctx = f"Codigo erroneo:\n{code}\nError:\n{check_res}"
        fixed_code = generate_code(task, filename, "Corrige los errores de sintaxis de este script Python.", fix_ctx)
        TOOLS["write_file"](filename, fixed_code)

    print(f"\n[JARO VERIFICADOR] Ejecutando prueba segura de {filename}...")
    print(TOOLS["run_check"]("run_py", filename))
    save_memory(task, "crear_python", [filename])


def edit_existing_file(task, filename):
    path_obj, current_content = read_any_pc_file(filename)
    if path_obj is None:
        print(f"[ERROR] {current_content}")
        return

    print(f"\n[JARO PLANIFICADOR] Modificando {path_obj}...")
    extra = f"Contenido actual:\n{current_content}\n"
    new_code = generate_code(task, path_obj.name, "Modifica el archivo aplicando las mejoras solicitadas.", extra)

    if path_obj.suffix == ".py":
        new_code = smart_merge_python(current_content, new_code)

    path_obj.write_text(new_code, encoding="utf-8")
    print(f"[OK] Archivo actualizado en: {path_obj}")
    save_memory(task, "editar_archivo", [str(path_obj)])


def run_all_checks():
    print(f"\n=== VERIFICACION TOTAL ({TOOLS['get_project']()}) ===")
    print(TOOLS["run_check"]("web"))
    for item in sorted(TOOLS["get_project"]().glob("*.py")):
        print(f"\nProbando {item.name}:")
        print(TOOLS["run_check"]("compile", item.name))
        print(TOOLS["run_check"]("run_py", item.name))


def route_task(task):
    low = task.lower()

    if low in ("ayuda", "help", "?"):
        mostrar_ayuda()
        return

    if low.startswith(("web ", "investiga ", "investigar ", "internet ", "busca en internet ")):
        for prefix in ("busca en internet ", "investigar ", "investiga ", "internet ", "web "):
            if low.startswith(prefix):
                query = task[len(prefix):].strip()
                if query:
                    investigate_web(query)
                    return

    if low.startswith(("imagen ", "ver imagen ", "mira ", "procesar imagen ")):
        for prefix in ("procesar imagen ", "ver imagen ", "imagen ", "mira "):
            if low.startswith(prefix):
                rest = task[len(prefix):].strip()
                parts = rest.split(maxsplit=1)
                img_path = parts[0]
                question = parts[1] if len(parts) > 1 else ""
                analyze_image(img_path, question)
                return

    if low.startswith(("leer ", "mostrar ", "cat ")):
        parts = task.split(maxsplit=1)
        if len(parts) == 2:
            target = parts[1].strip()
            p_check = resolve_pc_path(target)
            if p_check.suffix.lower() in IMAGE_EXTS:
                analyze_image(target)
                return
            path_obj, content = read_any_pc_file(target)
            if path_obj is None:
                print(f"\n[INFO/ERROR] {content}")
            else:
                print(f"\n[JARO LECTOR GLOBAL] ({path_obj})\n{content[:4000]}")
                if len(content) > 4000:
                    print(f"\n... [Mostrando primeros 4000 caracteres de {len(content)} totales]")
            return

    if low.startswith(("analizar ", "explicar ", "resumir ", "resume ")):
        fname = task.split(maxsplit=1)[1].strip()
        analyze_file(fname)
        return

    if low.startswith("proyecto"):
        parts = task.split(maxsplit=1)
        proj_name = parts[1] if len(parts) == 2 else ""
        print("\n[JARO GESTOR]", TOOLS["set_project"](proj_name))
        return

    if low in ("ver", "abrir", "navegador", "preview"):
        open_in_browser()
        return

    if low in ("git", "git status"):
        print("\n[JARO GIT STATUS]")
        print(TOOLS["run_check"]("git_status"))
        return

    if low in ("archivos", "listar", "ls", "ver archivos"):
        print(f"\n[JARO ARCHIVOS ({TOOLS['get_project']().name})]")
        print(TOOLS["list_files"]("."))
        return

    if low in ("memoria", "historial"):
        show_memory()
        return

    if low in ("verificar", "check", "pruebas"):
        run_all_checks()
        return

    if low.startswith("buscar "):
        query = task.split(maxsplit=1)[1].strip()
        print(f"\n[JARO BUSCADOR] ('{query}')")
        print(TOOLS["search_code"](query))
        return

    path_in_prompt = re.search(r"((?:~|/home/|/etc/|/var/|/usr/|/opt/|/tmp/|\./)[\w\-\./]+\.[\w]+)", task)
    if path_in_prompt:
        detected_path = path_in_prompt.group(1)
        p_check = resolve_pc_path(detected_path)
        if p_check.suffix.lower() in IMAGE_EXTS:
            analyze_image(detected_path, task)
            return
        p_obj, file_txt = read_any_pc_file(detected_path)
        if p_obj is not None:
            print(f"\n{YELLOW}[JARO FS]{RESET} Procesando documento detectado: {p_obj}...")
            prompt = f"Contenido del documento {p_obj.name}:\n{file_txt[:2500]}\n\nInstruccion del usuario: {task}"
            ans = call_ollama(prompt, max_tokens=800)
            print(f"\n{ans}\n")
            return

    file_match = re.search(r"([\w\-\./~]+\.(?:html|css|js|py|txt|json|md|sh|conf))", task)
    if file_match and any(w in low for w in ("edita", "modifica", "cambia", "agrega", "añade", "corrige", "arregla")):
        edit_existing_file(task, file_match.group(1))
        return

    if any(w in low for w in ("python", ".py", "script", "calculadora", "consola")):
        create_python_script(task)
        return

    if any(w in low for w in ("web", "página", "pagina", "html", "sitio", "landing", "portafolio", "negocio")):
        create_website(task)
        return

    print(f"\n{CYAN}[{MODEL}]{RESET} Procesando...")
    answer = call_ollama(task, max_tokens=800)
    print(f"\n{answer}\n")


def main():
    mostrar_banner()

    while True:
        try:
            proj_name = TOOLS["get_project"]().name
            task = input(f"\n{GREEN}Jaro ({proj_name}) >{RESET} ").strip()

            if task.lower() in ("salir", "exit", "quit"):
                print("Hasta pronto, programador.")
                break

            if not task:
                continue

            route_task(task)

        except KeyboardInterrupt:
            print("\nHasta pronto, programador.")
            break
        except Exception as error:
            print(f"\n[ERROR CRITICO] {error}")


if __name__ == "__main__":
    main()
